{%- assign base = section.settings.prompt_base -%}
{% if section.settings.show_details %}
<section class="container split details">
  <div class="split-copy"><p class="eyebrow">{{ 'product.details' | t }}</p><h2>{{ section.settings.detailTitle | escape }}</h2><p>{{ section.settings.detailText | escape | newline_to_br }}</p></div>
  <div class="split-media">{% assign pn = base | plus: 13 %}{% render 'rm-image', image: section.settings.image_13, asset: section.settings.asset_13, number: pn, width: 1200, height: 1500 %}</div>
</section>
{% endif %}
{% if section.settings.show_usage %}
<section class="container">
  <div class="section-head"><h2>{{ section.settings.usageTitle | escape }}</h2></div>
  <ol class="steps"><li>{{ section.settings.step1 | escape }}</li><li>{{ section.settings.step2 | escape }}</li><li>{{ section.settings.step3 | escape }}</li></ol>
</section>
{% endif %}
{% if section.settings.show_specifications %}
<section class="container split specs">
  <div class="split-media">{% assign pn = base | plus: 3 %}{% render 'rm-image', image: section.settings.image_3, asset: section.settings.asset_3, number: pn, width: 1200, height: 1200 %}</div>
  <div class="split-copy"><h2>{{ section.settings.specificationsTitle | escape }}</h2>
    <dl class="spec-list">{% assign lines = section.settings.specifications | newline_to_br | split: '<br />' %}{% for line in lines %}{% assign line = line | strip %}{% if line != blank %}{% assign parts = line | split: ':' %}{% if parts.size > 1 %}<div><dt>{{ parts[0] | escape }}</dt><dd>{{ line | remove_first: parts[0] | remove_first: ':' | strip | escape }}</dd></div>{% else %}<div><dd>{{ line | escape }}</dd></div>{% endif %}{% endif %}{% endfor %}</dl>
  </div>
</section>
{% endif %}
{% if section.settings.show_box and section.settings.box != blank %}<section class="container"><h2>{{ section.settings.boxTitle | escape }}</h2><p>{{ section.settings.box | escape | newline_to_br }}</p></section>{% endif %}
{% if section.settings.show_guarantee and section.settings.guarantee != blank %}<section class="container"><h2>{{ section.settings.guaranteeTitle | escape }}</h2><p>{{ section.settings.guarantee | escape | newline_to_br }}</p></section>{% endif %}
{% if section.settings.show_closing %}
<section class="final-cta"><h2>{{ section.settings.finalTitle | escape }}</h2><p>{{ section.settings.finalText | escape }}</p><a class="button button-light" href="#product-top">{{ 'product.choose' | t }}</a></section>
{% endif %}
{% if section.settings.show_faq %}
<section class="container faq">
  <h2>{{ section.settings.faqTitle | escape }}</h2>
  {% for i in (1..3) %}{% assign q = 'faq' | append: i | append: 'Question' %}{% assign a = 'faq' | append: i | append: 'Answer' %}{% if section.settings[q] != blank %}<details><summary>{{ section.settings[q] | escape }}</summary><p>{{ section.settings[a] | escape | newline_to_br }}</p></details>{% endif %}{% endfor %}
</section>
{% endif %}
